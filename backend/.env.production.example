# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (get from: console.neon.tech → Connection Details)
# Format: postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://talentlens_owner:YOURPASSWORD@ep-xxx.us-east-2.aws.neon.tech/talentlens?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters

# ─── App Environment ──────────────────────────────────────────────────────────
APP_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your deployed Netlify URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://YOUR-APP-NAME.netlify.app

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Get from: console.upstash.com → Redis → Connect → .env tab
# Format: rediss://default:PASSWORD@HOST.upstash.io:PORT
REDIS_URL=rediss://default:YOURPASSWORD@YOUR-HOST.upstash.io:6379
