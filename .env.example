DATABASE_URL=sqlite:///./talentlens.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME

# Docker Compose development defaults. Change the password for any shared environment.
POSTGRES_USER=talentlens
POSTGRES_PASSWORD=talentlens_dev_password
POSTGRES_DB=talentlens
VITE_API_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
# Comma-separated browser origins; set the deployed frontend URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set a strong value outside local development.
JWT_SECRET_KEY=replace-with-a-development-secret-at-least-32-characters